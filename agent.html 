<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Create AI Agent - ShopBrain</title>
<style>
* { box-sizing: border-box; }
body { margin: 0; font-family: Arial, sans-serif; background: #f5f7fb; color: #111827; }
header { background: #111827; color: white; padding: 18px; }
.header { max-width: 900px; margin: auto; display: flex; justify-content: space-between; align-items: center; }
.logo { font-size: 24px; font-weight: bold; }
.logo span { color: #3b82f6; }
.back { color: white; text-decoration: none; font-weight: bold; }
.container { max-width: 720px; margin: 40px auto; padding: 20px; }
.card { background: white; padding: 30px; border-radius: 18px; box-shadow: 0 8px 30px rgba(0,0,0,.07); }
h1 { margin-top: 0; font-size: 28px; }
.subtitle { color: #6b7280; line-height: 1.6; margin-bottom: 25px; }
label { display: block; font-weight: bold; margin-top: 20px; margin-bottom: 8px; }
input, textarea { width: 100%; padding: 14px; border: 1px solid #d1d5db; border-radius: 10px; font-size: 15px; font-family: Arial, sans-serif; }
textarea { min-height: 120px; resize: vertical; }
input:focus, textarea:focus { outline: none; border-color: #2563eb; box-shadow: 0 0 0 3px rgba(37,99,235,.1); }
button { width: 100%; margin-top: 28px; padding: 15px; background: #2563eb; color: white; border: none; border-radius: 10px; font-size: 16px; font-weight: bold; cursor: pointer; }
button:hover { background: #1d4ed8; }
button:disabled { background: #9ca3af; cursor: not-allowed; }
.message { display: none; padding: 14px; margin-bottom: 20px; border-radius: 10px; line-height: 1.5; }
.error { background: #fee2e2; color: #991b1b; }
.success { background: #dcfce7; color: #166534; }
.info { background: #dbeafe; color: #1e40af; }
.hidden { display: none !important; }
.section-title { margin-top: 30px; padding-top: 20px; border-top: 1px solid #e5e7eb; font-size: 18px; }
.dash-link { display: block; text-align: center; margin-top: 15px; padding: 14px; background: #111827; color: white; border-radius: 10px; text-decoration: none; font-weight: bold; }
</style>
</head>
<body>
<header>
  <div class="header">
    <div class="logo">Shop<span>Brain</span></div>
    <a href="dashboard.html" class="back">← Dashboard</a>
  </div>
</header>

<main class="container">
  <div class="card">
    <h1>🤖 Create Your AI Agent</h1>
    <p class="subtitle">Create your ShopBrain customer-service AI. Add your business information and teach your AI how to help your customers.</p>

    <div id="loadingMessage" class="message info">Loading your account...</div>
    <div id="infoMessage" class="message info"></div>
    <div id="errorMessage" class="message error"></div>
    <div id="successMessage" class="message success"></div>

    <form id="agentForm" class="hidden">
      <label for="agentName">AI Agent Name</label>
      <input id="agentName" type="text" placeholder="Example: Shop Assistant" required>

      <label for="businessName">Business Name</label>
      <input id="businessName" type="text" placeholder="Example: Shopora Market Hub" required>

      <label for="businessDescription">About Your Business</label>
      <textarea id="businessDescription" placeholder="Example:&#10;We sell gadgets and electronics.&#10;We deliver worldwide.&#10;Customers can contact us for support."></textarea>

      <h2 class="section-title">📦 Products & Services</h2>
      <textarea id="products" placeholder="Example:&#10;Wireless Earbuds - $29&#10;Smart Watch - $49&#10;Phone Cases - $15"></textarea>

      <h2 class="section-title">🚚 Shipping Information</h2>
      <textarea id="shipping" placeholder="Example:&#10;We deliver worldwide.&#10;Delivery takes 3-5 business days."></textarea>

      <h2 class="section-title">🔄 Refund & Return Policy</h2>
      <textarea id="refund" placeholder="Example:&#10;Customers can return unused products within 14 days."></textarea>

      <h2 class="