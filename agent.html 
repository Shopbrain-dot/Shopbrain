<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Create AI Agent - ShopBrain</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #f5f7fb;
  color: #111827;
}

header {
  background: #111827;
  color: white;
  padding: 18px;
}

.header {
  max-width: 900px;
  margin: auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.logo {
  font-size: 24px;
  font-weight: bold;
}

.logo span {
  color: #3b82f6;
}

.back {
  color: white;
  text-decoration: none;
  font-weight: bold;
}

.container {
  max-width: 720px;
  margin: 40px auto;
  padding: 20px;
}

.card {
  background: white;
  padding: 30px;
  border-radius: 18px;
  box-shadow: 0 8px 30px rgba(0,0,0,.07);
}

h1 {
  margin-top: 0;
  font-size: 28px;
}

.subtitle {
  color: #6b7280;
  line-height: 1.6;
  margin-bottom: 25px;
}

label {
  display: block;
  font-weight: bold;
  margin-top: 20px;
  margin-bottom: 8px;
}

input,
textarea {
  width: 100%;
  padding: 14px;
  border: 1px solid #d1d5db;
  border-radius: 10px;
  font-size: 15px;
  font-family: Arial, sans-serif;
}

textarea {
  min-height: 120px;
  resize: vertical;
}

input:focus,
textarea:focus {
  outline: none;
  border-color: #2563eb;
}

button {
  width: 100%;
  margin-top: 28px;
  padding: 15px;
  background: #2563eb;
  color: white;
  border: none;
  border-radius: 10px;
  font-size: 16px;
  font-weight: bold;
  cursor: pointer;
}

button:hover {
  background: #1d4ed8;
}

button:disabled {
  background: #9ca3af;
  cursor: not-allowed;
}

.message {
  display: none;
  padding: 14px;
  margin-bottom: 20px;
  border-radius: 10px;
  line-height: 1.5;
}

.error {
  background: #fee2e2;
  color: #991b1b;
}

.success {
  background: #dcfce7;
  color: #166534;
}

.info {
  background: #dbeafe;
  color: #1e40af;
}

.hidden {
  display: none !important;
}

.existing {
  background: #f3f4f6;
  padding: 20px;
  border-radius: 12px;
  margin-top: 20px;
}

.existing h3 {
  margin-top: 0;
}

.existing-buttons {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.existing-buttons a {
  text-decoration: none;
  padding: 12px 16px;
  border-radius: 8px;
  color: white;
  background: #2563eb;
  font-weight: bold;
}

.existing-buttons a.secondary {
  background: #111827;
}

@media (max-width: 600px) {
  .container {
    margin: 15px auto;
    padding: 15px;
  }

  .card {
    padding: 22px;
  }
}
</style>
</head>

<body>

<header>
  <div class="header">

    <div class="logo">
      Shop<span>Brain</span>
    </div>

    <a
      href="dashboard.html"
      class="back"
    >
      ← Dashboard
    </a>

  </div>
</header>


<main class="container">

  <div class="card">

    <h1>🤖 Create Your AI Agent</h1>

    <p class="subtitle">
      Create your ShopBrain customer-service AI.
      Add your business information and your AI will use it
      to help your customers.
    </p>


    <div
      id="loadingMessage"
      class="message info"
    >
      Checking your account...
    </div>


    <div
      id="infoMessage"
      class="message info"
    ></div>


    <div
      id="errorMessage"
      class="message error"
    ></div>


    <div
      id="successMessage"
      class="message success"
    ></div>


    <!-- EXISTING AGENT -->

    <div
      id="existingAgent"
      class="existing hidden"
    >

      <h3>
        🤖 You already have an AI agent
      </h3>

      <p>
        Each ShopBrain account can have one AI agent.
        You can continue training and managing your existing AI.
      </p>

      <p>
        <strong id="existingAgentName">
          ShopBrain AI
        </strong>
      </p>

      <div class="existing-buttons">

        <a href="dashboard.html">
          Go to Dashboard
        </a>

        <a
          href="train.html"
          class="secondary"
        >
          Train AI
        </a>

        <a
          href="chat.html"
          class="secondary"
        >
          Test AI
        </a>

      </div>

    </div>


    <!-- CREATE FORM -->

    <form
      id="agentForm"
      class="hidden"
    >

      <label for="agentName">
        AI Agent Name
      </label>

      <input
        id="agentName"
        type="text"
        placeholder="Example: ShopBrain Assistant"
        required
      >


      <label for="businessName">
        Business Name
      </label>

      <input
        id="businessName"
        type="text"
        placeholder="Example: Nestylo Store"
        required
      >


      <label for="businessDescription">
        What does your business do?
      </label>

      <textarea
        id="businessDescription"
        placeholder="Describe your business, products or services..."
      ></textarea>


      <label for="welcomeMessage">
        AI Welcome Message
      </label>

      <textarea
        id="welcomeMessage"
        placeholder="Hi! How can I help you today?"
      >Hi! 👋 How can I help you today?</textarea>


      <button
        id="createButton"
        type="submit"
      >
        🚀 Create AI Agent
      </button>

    </form>

  </div>

</main>


<!-- =====================================================
     IMPORTANT:
     SUPABASE LIBRARY MUST LOAD FIRST
===================================================== -->

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<script src="supabase-config.js"></script>


<script>

const loadingMessage =
  document.getElementById(
    "loadingMessage"
  );

const infoMessage =
  document.getElementById(
    "infoMessage"
  );

const errorMessage =
  document.getElementById(
    "errorMessage"
  );

const successMessage =
  document.getElementById(
    "successMessage"
  );

const existingAgent =
  document.getElementById(
    "existingAgent"
  );

const existingAgentName =
  document.getElementById(
    "existingAgentName"
  );

const agentForm =
  document.getElementById(
    "agentForm"
  );

const createButton =
  document.getElementById(
    "createButton"
  );


function hideMessages() {

  infoMessage.style.display =
    "none";

  errorMessage.style.display =
    "none";

  successMessage.style.display =
    "none";

}


function showError(message) {

  errorMessage.textContent =
    message;

  errorMessage.style.display =
    "block";

}


function showSuccess(message) {

  successMessage.textContent =
    message;

  successMessage.style.display =
    "block";

}


/*
==================================================
CHECK SUPABASE
==================================================
*/

if (
  typeof supabase === "undefined"
) {

  loadingMessage.style.display =
    "none";

  showError(
    "Supabase library could not load. Please check your internet connection."
  );

}


/*
==================================================
CHECK ACCOUNT
==================================================
*/

async function initializeAgentPage() {

  hideMessages();

  loadingMessage.style.display =
    "block";

  agentForm.classList.add(
    "hidden"
  );

  existingAgent.classList.add(
    "hidden"
  );


  try {

    /*
    Make sure supabase-config.js
    created the client.
    */

    if (
      typeof supabaseClient ===
      "undefined"
    ) {

      throw new Error(
        "supabaseClient is not defined. Check supabase-config.js and make sure the Supabase library loads before it."
      );

    }


    /*
    Get logged-in user
    */

    const {
      data: {
        user
      },
      error: userError
    } =
      await supabaseClient.auth.getUser();


    if (userError) {

      throw userError;

    }


    /*
    User is not logged in
    */

    if (!user) {

      window.location.href =
        "login.html";

      return;

    }


    /*
    Check whether this user
    already has an agent.
    */

    const {
      data: agent,
      error: agentError
    } =
      await supabaseClient
        .from("agents")
        .select("*")
        .eq(
          "user_id",
          user.id
        )
        .maybeSingle();


    if (agentError) {

      throw agentError;

    }


    loadingMessage.style.display =
      "none";


    /*
    EXISTING AGENT
    */

    if (agent) {

      existingAgentName.textContent =
        agent.agent_name ||
        "ShopBrain AI";

      existingAgent.classList.remove(
        "hidden"
      );

      return;

    }


    /*
    NO AGENT YET
    */

    agentForm.classList.remove(
      "hidden"
    );

  }

  catch (error) {

    console.error(
      "Agent check error:",
      error
    );

    loadingMessage.style.display =
      "none";

    showError(
      "Could not check your existing AI agent: " +
      (
        error.message ||
        "Unknown error"
      )
    );

  }

}


/*
==================================================
CREATE AGENT
==================================================
*/

agentForm.addEventListener(
  "submit",
  async function(event) {

    event.preventDefault();

    hideMessages();


    createButton.disabled =
      true;

    createButton.textContent =
      "Creating your AI...";


    try {

      /*
      Get current user
      */

      const {
        data: {
          user
        },
        error: userError
      } =
        await supabaseClient.auth.getUser();


      if (userError) {

        throw userError;

      }


      if (!user) {

        window.location.href =
          "login.html";

        return;

      }


      /*
      Get form data
      */

      const agentName =
        document
          .getElementById(
            "agentName"
          )
          .value
          .trim();

      const businessName =
        document
          .getElementById(
            "businessName"
          )
          .value
          .trim();

      const businessDescription =
        document
          .getElementById(
            "businessDescription"
          )
          .value
          .trim();

      const welcomeMessage =
        document
          .getElementById(
            "welcomeMessage"
          )
          .value
          .trim();


      /*
      Validate
      */

      if (!agentName) {

        throw new Error(
          "Please enter an AI agent name."
        );

      }


      if (!businessName) {

        throw new Error(
          "Please enter your business name."
        );

      }


      /*
      Create agent in Supabase
      */

      const {
        data: newAgent,
        error: createError
      } =
        await supabaseClient
          .from("agents")
          .insert({

            user_id:
              user.id,

            agent_name:
              agentName,

            business_name:
              businessName,

            business_description:
              businessDescription ||
              null,

            welcome_message:
              welcomeMessage ||
              "Hi! 👋 How can I help you today?"

          })
          .select()
          .single();


      if (createError) {

        /*
        If another agent already exists,
        show the existing-agent message.
        */

        if (
          createError.code ===
          "23505"
        ) {

          throw new Error(
            "You already have a ShopBrain AI agent."
          );

        }

        throw createError;

      }


      /*
      Agent successfully created
      */

      showSuccess(
        "🎉 Your AI agent has been created successfully!"
      );


      /*
      Give Supabase a moment,
      then go to training.
      */

      setTimeout(
        function() {

          window.location.href =
            "train.html";

        },
        1000
      );

    }

    catch (error) {

      console.error(
        "Create agent error:",
        error
      );

      showError(
        error.message ||
        "Could not create your AI agent."
      );


      createButton.disabled =
        false;

      createButton.textContent =
        "🚀 Create AI Agent";

    }

  }
);


/*
==================================================
START
==================================================
*/

initializeAgentPage();

</script>

</body>
</html>