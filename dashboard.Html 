<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>ShopBrain Dashboard</title>

<style>

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #f5f7fb;
  color: #111827;
}

header {
  background: #111827;
  color: white;
  padding: 18px;
}

.header {
  max-width: 1000px;
  margin: auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.logo {
  font-size: 24px;
  font-weight: bold;
}

.logo span {
  color: #3b82f6;
}

.logout {
  background: #dc2626;
  color: white;
  border: none;
  padding: 10px 15px;
  border-radius: 7px;
  cursor: pointer;
}

.container {
  max-width: 1000px;
  margin: 40px auto;
  padding: 20px;
}

.welcome {
  margin-bottom: 30px;
}

.welcome h1 {
  font-size: 30px;
}

.welcome p {
  color: #6b7280;
}

.card {
  background: white;
  padding: 25px;
  border-radius: 15px;
  margin-bottom: 25px;
  box-shadow: 0 5px 20px rgba(0,0,0,0.05);
}

.card h2 {
  margin-top: 0;
}

.agent-info {
  background: #f3f4f6;
  padding: 20px;
  border-radius: 10px;
  margin: 20px 0;
}

.status {
  color: #16a34a;
  font-weight: bold;
}

.buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.button {
  display: inline-block;
  text-decoration: none;
  color: white;
  background: #2563eb;
  padding: 14px 18px;
  border-radius: 8px;
  font-weight: bold;
}

.green {
  background: #16a34a;
}

.dark {
  background: #111827;
}

.orange {
  background: #ea580c;
}

#createAI {
  display: none;
}

#myAI {
  display: none;
}

</style>

</head>

<body>


<header>

<div class="header">

<div class="logo">
Shop<span>Brain</span>
</div>

<button
class="logout"
onclick="logout()"
>
Logout
</button>

</div>

</header>


<div class="container">


<div class="welcome">

<h1 id="welcome">
Welcome to ShopBrain 👋
</h1>

<p>
Manage your customer-service AI from here.
</p>

</div>


<!-- CREATE AI -->

<div
class="card"
id="createAI"
>

<h2>
🤖 Create Your AI
</h2>

<p>
Create your customer-service AI agent.
Each account can create only one AI.
</p>

<a
href="agent.html"
class="button"
>
🚀 Create AI Agent
</a>

</div>


<!-- EXISTING AI -->

<div
class="card"
id="myAI"
>

<h2>
🤖 Your AI Agent
</h2>


<div class="agent-info">

<h3 id="agentName">
ShopBrain Assistant
</h3>

<p>
Business:
<strong id="businessName">
Your Business
</strong>
</p>

<p>
Status:
<span class="status">
● Active
</span>
</p>

</div>


<div class="buttons">

<a
href="train.html"
class="button green"
>
🧠 Train AI
</a>


<a
href="chat.html"
class="button"
>
💬 Test AI
</a>


<a
href="train.html"
class="button dark"
>
⚙️ Manage AI
</a>


<a
href="chat.html"
class="button orange"
>
🔗 Connect Website
</a>

</div>

</div>


<!-- HELP -->

<div class="card">

<h2>
📚 How ShopBrain Works
</h2>

<p>
Create one AI agent for your business.
Then train that same AI as many times as you want.
</p>

<p>
You can add products, prices, FAQs, delivery
information, refund policies and other business
knowledge whenever you want.
</p>

</div>


</div>


<script>


/*
Check if account exists.
*/

const user =
localStorage.getItem("shopbrainUser");


if (!user) {

window.location.href =
"signup.html";

}


/*
Load account information.
*/

try {

const userData =
JSON.parse(user);

if (userData) {

document.getElementById(
"welcome"
).textContent =
"Welcome to ShopBrain 👋";

}

} catch (error) {

/*
If the saved account isn't JSON,
the dashboard still works.
*/

}


/*
Check for existing AI.
*/

const savedAgent =
localStorage.getItem("shopbrainAgent");


if (savedAgent) {


document.getElementById(
"myAI"
).style.display =
"block";


document.getElementById(
"createAI"
).style.display =
"none";


try {

const agent =
JSON.parse(savedAgent);


if (agent.agentName) {

document.getElementById(
"agentName"
).textContent =
agent.agentName;

}


if (agent.businessName) {

document.getElementById(
"businessName"
).textContent =
agent.businessName;

}

} catch (error) {

console.log(
"Agent data loaded."
);

}


} else {


document.getElementById(
"createAI"
).style.display =
"block";


document.getElementById(
"myAI"
).style.display =
"none";

}


/*
Logout
*/

function logout() {

localStorage.removeItem(
"shopbrainUser"
);

window.location.href =
"index.html";

}

</script>


</body>
</html>