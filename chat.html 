<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Test AI - ShopBrain</title>
<style>
* { box-sizing: border-box; }
body { margin: 0; font-family: Arial, sans-serif; background: #f5f7fb; color: #111827; }
header { background: #111827; color: white; padding: 18px; }
.header { max-width: 700px; margin: auto; display: flex; justify-content: space-between; align-items: center; }
.logo { font-size: 24px; font-weight: bold; }
.logo span { color: #3b82f6; }
.back { color: white; text-decoration: none; }
.container { max-width: 700px; margin: 30px auto; padding: 20px; }
.chatbox { background: white; border-radius: 16px; box-shadow: 0 8px 30px rgba(0,0,0,.07); display: flex; flex-direction: column; height: 70vh; }
.messages { flex: 1; overflow-y: auto; padding: 20px; }
.msg { max-width: 80%; padding: 12px 16px; border-radius: 14px; margin-bottom: 12px; line-height: 1.5; white-space: pre-wrap; }
.msg.user { background: #2563eb; color: white; margin-left: auto; border-bottom-right-radius: 4px; }
.msg.ai { background: #f3f4f6; color: #111827; margin-right: auto; border-bottom-left-radius: 4px; }
.msg.error { background: #fee2e2; color: #991b1b; margin-right: auto; }
.input-row { display: flex; gap: 10px; padding: 15px; border-top: 1px solid #e5e7eb; }
.input-row input { flex: 1; padding: 13px; border: 1px solid #d1d5db; border-radius: 9px; font-size: 15px; }
.input-row button { padding: 13px 20px; background: #2563eb; color: white; border: none; border-radius: 9px; font-weight: bold; cursor: pointer; }
.input-row button:disabled { background: #9ca3af; cursor: not-allowed; }
.status { text-align: center; color: #6b7280; padding: 40px 0; }
</style>
</head>
<body>
<header>
  <div class="header">
    <div class="logo">Shop<span>Brain</span></div>
    <a href="dashboard.html" class="back">← Dashboard</a>
  </div>
</header>

<div class="container">
  <div class="chatbox">
    <div class="messages" id="messages">
      <div class="status" id="status">Loading your AI agent...</div>
    </div>
    <div class="input-row">
      <input type="text" id="messageInput" placeholder="Ask your AI a question..." disabled>
      <button id="sendButton" disabled>Send</button>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="supabase-config.js"></script>
<script>
let agentId = null;
const messagesEl = document.getElementById("messages");
const statusEl = document.getElementById("status");
const input = document.getElementById("messageInput");
const sendButton = document.getElementById("sendButton");

function addMessage(text, cls) {
  const div = document.createElement("div");
  div.className = "msg " + cls;
  div.textContent = text;
  messagesEl.appendChild(div);
  messagesEl.scrollTop = messagesEl.scrollHeight;
}

async function init() {
  const { data: { user }, error } = await supabaseClient.auth.getUser();
  if (error || !user) {
    window.location.href = "login.html";
    return;
  }

  const { data: agent, error: agentError } = await supabaseClient
    .from("agents")
    .select("id, agent_name, welcome_message")
    .eq("user_id", user.id)
    .maybeSingle();

  if (agentError || !agent) {
    statusEl.textContent = "You need to create an AI agent first.";
    return;
  }

  agentId = agent.id;
  statusEl.remove();
  addMessage(agent.welcome_message || "Hi! How can I help you today?", "ai");
  input.disabled = false;
  sendButton.disabled = false;
  input.focus();
}

async function sendMessage() {
  const text = input.value.trim();
  if (!text || !agentId) return;

  addMessage(text, "user");
  input.value = "";
  input.disabled = true;
  sendButton.disabled = true;

  try {
    // Calls the Edge Function. The Gemini key never touches this page —
    // it's read from Supabase Secrets inside the function.
    const { data, error } = await supabaseClient.functions.invoke("chat-agent", {
      body: { agentId: agentId, message: text }
    });

    if (error) throw error;
    if (data && data.error) throw new Error(data.error);

    addMessage(data.reply || "(no reply)", "ai");
  } catch (error) {
    console.error("Chat error:", error);
    addMessage(error.message || "Something went wrong talking to your AI.", "error");
  } finally {
    input.disabled = false;
    sendButton.disabled = false;
    input.focus();
  }
}

sendButton.addEventListener("click", sendMessage);
input.addEventListener("keydown", function (e) {
  if (e.key === "Enter") sendMessage();
});

init();
</script>
</body>
</html>