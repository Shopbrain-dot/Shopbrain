<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="ShopBrain AI customer service dashboard">

  <title>ShopBrain Dashboard</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      background: #f5f7fb;
      color: #111827;
    }

    .layout {
      display: flex;
      min-height: 100vh;
    }

    .sidebar {
      width: 240px;
      background: #111827;
      color: white;
      padding: 25px 15px;
    }

    .logo {
      font-size: 24px;
      font-weight: bold;
      padding: 0 15px 30px;
    }

    .logo span {
      color: #3b82f6;
    }

    .menu a {
      display: block;
      padding: 13px 15px;
      margin-bottom: 5px;
      color: #d1d5db;
      text-decoration: none;
      border-radius: 8px;
    }

    .menu a:hover {
      background: #1f2937;
      color: white;
    }

    .main {
      flex: 1;
      padding: 30px;
    }

    .top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 30px;
    }

    .top h1 {
      font-size: 28px;
      margin-bottom: 5px;
    }

    .top p {
      color: #6b7280;
    }

    .profile {
      background: white;
      padding: 10px 15px;
      border-radius: 8px;
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      margin-bottom: 30px;
    }

    .stat {
      background: white;
      padding: 22px;
      border-radius: 12px;
      box-shadow: 0 3px 15px rgba(0,0,0,0.04);
    }

    .stat p {
      color: #6b7280;
      margin-bottom: 10px;
    }

    .stat h2 {
      font-size: 28px;
    }

    .status {
      color: #16a34a;
      font-size: 20px !important;
    }

    .agent {
      background: white;
      padding: 30px;
      border-radius: 14px;
      margin-bottom: 25px;
    }

    .agent-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
    }

    .agent h2 {
      margin-bottom: 8px;
    }

    .agent p {
      color: #6b7280;
    }

    .create {
      display: inline-block;
      background: #2563eb;
      color: white;
      padding: 13px 20px;
      border-radius: 8px;
      font-weight: bold;
      text-decoration: none;
      white-space: nowrap;
    }

    .create:hover {
      background: #1d4ed8;
    }

    .training {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .training-card {
      background: white;
      padding: 25px;
      border-radius: 12px;
    }

    .training-card h3 {
      margin-bottom: 10px;
    }

    .training-card p {
      color: #6b7280;
      line-height: 1.5;
    }

    @media (max-width: 800px) {

      .sidebar {
        width: 70px;
      }

      .logo {
        font-size: 0;
      }

      .logo span {
        font-size: 20px;
      }

      .menu a {
        font-size: 0;
        text-align: center;
      }

      .stats {
        grid-template-columns: 1fr 1fr;
      }

      .training {
        grid-template-columns: 1fr;
      }

      .agent-header {
        flex-direction: column;
        align-items: flex-start;
      }

      .top {
        flex-direction: column;
        align-items: flex-start;
        gap: 15px;
      }
    }
  </style>
</head>

<body>

<div class="layout">

  <aside class="sidebar">

    <div class="logo">
      Shop<span>Brain</span>
    </div>

    <div class="menu">

      <a href="dashboard.html">🏠 Dashboard</a>

      <a href="agent.html">🤖 AI Agent</a>

      <a href="agent.html">📚 Knowledge</a>

      <a href="#">💬 Conversations</a>

      <a href="#">📊 Analytics</a>

      <a href="#">⚙️ Settings</a>

    </div>

  </aside>


  <main class="main">

    <div class="top">

      <div>
        <h1>Dashboard</h1>
        <p>Manage your ShopBrain AI customer service.</p>
      </div>

      <div class="profile">
        👤 Business Owner
      </div>

    </div>


    <div class="stats">

      <div class="stat">
        <p>Total conversations</p>
        <h2>0</h2>
      </div>

      <div class="stat">
        <p>AI answered</p>
        <h2>0</h2>
      </div>

      <div class="stat">
        <p>Customers</p>
        <h2>0</h2>
      </div>

      <div class="stat">
        <p>AI status</p>
        <h2 class="status">Active</h2>
      </div>

    </div>


    <div class="agent">

      <div class="agent-header">

        <div>

          <h2>🤖 Customer Service AI</h2>

          <p>
            Create and train your ShopBrain customer-service agent.
          </p>

        </div>

        <a href="agent.html" class="create">
          + Create AI Agent
        </a>

      </div>

    </div>


    <h2 style="margin-bottom:15px;">
      Train Your AI
    </h2>

    <div class="training">

      <div class="training-card">

        <h3>📦 Products</h3>

        <p>
          Add your products, prices, descriptions and stock information.
        </p>

      </div>


      <div class="training-card">

        <h3>❓ FAQs</h3>

        <p>
          Add common customer questions and the answers your AI should give.
        </p>

      </div>


      <div class="training-card">

        <h3>📄 Business Information</h3>

        <p>
          Add shipping, refunds, opening hours, contact information and policies.
        </p>

      </div>

    </div>

  </main>

</div>

</body>
</html>