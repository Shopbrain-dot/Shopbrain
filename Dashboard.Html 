<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>ShopBrain Dashboard</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #f5f7fb;
  color: #111827;
}

header {
  background: #111827;
  color: white;
  padding: 18px;
}

.header {
  max-width: 1100px;
  margin: auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.logo {
  font-size: 24px;
  font-weight: bold;
}

.logo span {
  color: #3b82f6;
}

.logout {
  background: #dc2626;
  color: white;
  border: none;
  padding: 10px 16px;
  border-radius: 8px;
  cursor: pointer;
  font-weight: bold;
}

.container {
  max-width: 1100px;
  margin: 35px auto;
  padding: 0 20px;
}

.welcome {
  margin-bottom: 30px;
}

.welcome h1 {
  font-size: 30px;
  margin-bottom: 8px;
}

.welcome p {
  color: #6b7280;
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-bottom: 30px;
}

.stat {
  background: white;
  padding: 25px;
  border-radius: 14px;
  box-shadow: 0 4px 20px rgba(0,0,0,0.05);
}

.stat p {
  color: #6b7280;
  margin-bottom: 10px;
}

.stat h2 {
  font-size: 28px;
  margin: 0;
}

.active {
  color: #16a34a;
}

.card {
  background: white;
  padding: 30px;
  border-radius: 14px;
  margin-bottom: 25px;
  box-shadow: 0 4px 20px rgba(0,0,0,0.05);
}

.card h2 {
  margin-top: 0;
}

.card p {
  color: #6b7280;
  line-height: 1.6;
}

.agent-box {
  background: #f9fafb;
  padding: 20px;
  border-radius: 10px;
  margin: 20px 0;
}

.agent-box h3 {
  margin-top: 0;
}

.status {
  color: #16a34a;
  font-weight: bold;
}

.buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.button {
  display: inline-block;
  background: #2563eb;
  color: white;
  padding: 14px 20px;
  border-radius: 9px;
  text-decoration: none;
  font-weight: bold;
}

.button:hover {
  background: #1d4ed8;
}

.secondary {
  background: #111827;
}

.secondary:hover {
  background: #1f2937;
}

.green {
  background: #16a34a;
}

.green:hover {
  background: #15803d;
}

.orange {
  background: #ea580c;
}

.orange:hover {
  background: #c2410c;
}

#createSection {
  display: none;
}

#agentSection {
  display: none;
}

@media