<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Train AI - ShopBrain</title>
<style>
* { box-sizing: border-box; }
body { margin: 0; font-family: Arial, sans-serif; background: #f5f7fb; color: #111827; }
header { background: #111827; color: white; padding: 18px; }
.header { max-width: 900px; margin: auto; display: flex; justify-content: space-between; align-items: center; }
.logo { font-size: 24px; font-weight: bold; }
.logo span { color: #3b82f6; }
.back { color: white; text-decoration: none; }
.container { max-width: 900px; margin: 35px auto; padding: 20px; }
.title { text-align: center; margin-bottom: 30px; }
.title h1 { font-size: 32px; }
.title p { color: #6b7280; }
.card { background: white; padding: 28px; border-radius: 15px; margin-bottom: 25px; box-shadow: 0 5px 20px rgba(0,0,0,.05); }
.card h2 { margin-top: 0; }
label { display: block; font-weight: bold; margin-bottom: 8px; }
input, textarea, select { width: 100%; padding: 14px; border: 1px solid #d1d5db; border-radius: 9px; font-size: 15px; margin-bottom: 15px; font-family: Arial, sans-serif; }
textarea { min-height: 170px; resize: vertical; }
button { width: 100%; padding: 15px; border: none; border-radius: 9px; color: white; font-size: 16px; font-weight: bold; cursor: pointer; }
.website-button { background: #16a34a; }
.train-button { background: #2563eb; }
button:disabled { background: #9ca3af; cursor: not-allowed; }
.message { display: none; margin-top: 15px; padding: 14px; border-radius: 9px; line-height: 1.5; }
.success { background: #dcfce7; color: #166534; }
.info { background: #dbeafe; color: #1e40af; }
.error { background: #fee2e2; color: #991b1b; }
.knowledge-item { background: #f9fafb; padding: 16px; border-radius: 10px; margin-bottom: 10px; }
.knowledge-item .type { font-size: 12px; font-weight: bold; color: #2563eb; text-transform: uppercase; }
.knowledge-item .title { font-weight: bold; margin: 4px 0; }
.knowledge-item .content { white-space: pre-wrap; line-height: 1.5; color: #374151; }
</style>
</head>
<body>
<header>
  <div class="header">
    <div class="logo">Shop<span>Brain</span></div>
    <a href="dashboard.html" class="back">← Dashboard</a>
  </div>
</header>

<div class="container">
  <div class="title">
    <h1>🧠 Train Your AI</h1>
    <p>Train your AI as many times as you want.</p>
  </div>

  <div class="card">
    <h2>🌐 Train From Your Website</h2>
    <p>Paste your public business website and ShopBrain will extract its available information.</p>
    <label>Website URL</label>
    <input type="url" id="websiteUrl" placeholder="https://yourbusiness.com">
    <button class="website-button" id="websiteButton">🔍 Import Website</button>
    <div class="message info" id="websiteInfo"></div>
  </div>

  <div class="card">
    <h2>✍️ Train Manually</h2>
    <p>Add new information to your existing AI. You can do this unlimited times.</p>
    <label>New Training Information</label>
    <textarea id="training" placeholder="Example:&#10;Our new product is Samsung S25.&#10;Price: $799.&#10;Delivery takes 3-5 business days."></textarea>
    <button class="train-button" id="trainButton">🧠 Add Training</button>
    <div class="message success" id="success">✅ New knowledge added to your AI!</div>
    <div class="message error" id="trainError"></div>
  </div>

  <div class="card">
    <h2>📚 AI Knowledge</h2>
    <div id="knowledge">Loading...</div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="supabase-config.js"></script>
<script>
let currentUser = null;
let currentAgent = null;

async function init() {
  const { data: { user }, error } = await supabaseClient.auth.getUser();
  if (error || !user) {
    window.location.href = "login.html";
    return;
  }
  currentUser = user;

  const { data: agent, error: agentError } = await supabaseClient
    .from("agents")
    .select("id, agent_name, business_name")
    .eq("user_id", user.id)
    .maybeSingle();

  if (agentError) {
    document.getElementById("knowledge").textContent = "Could not load your AI agent.";
    return;
  }

  if (!agent) {
    // No agent yet — send them to create one first.
    window.location.href = "agent.html";
    return;
  }

  currentAgent = agent;
  await loadKnowledge();
}

async function loadKnowledge() {
  const container = document.getElementById("knowledge");
  const { data: rows, error } = await supabaseClient
    .from("knowledge")
    .select("id, type, title, content, updated_at")
    .eq("agent_id", currentAgent.id)
    .order("updated_at", { ascending: false });

  if (error) {
    container.textContent = "Could not load training data: " + error.message;
    return;
  }

  if (!rows || rows.length === 0) {
    container.textContent = "No training information yet.";
    return;
  }

  container.innerHTML = "";
  rows.forEach(function (row) {
    const div = document.createElement("div");
    div.className = "knowledge-item";
    div.innerHTML =
      '<div class="type">' + row.type + '</div>' +
      '<div class="title">' + (row.title || "") + '</div>' +
      '<div class="content"></div>';
    div.querySelector(".content").textContent = row.content || "";
    container.appendChild(div);
  });
}

document.getElementById("trainButton").addEventListener("click", async function () {
  const textarea = document.getElementById("training");
  const text = textarea.value.trim();
  const successMsg = document.getElementById("success");
  const errorMsg = document.getElementById("trainError");
  successMsg.style.display = "none";
  errorMsg.style.display = "none";

  if (!text) {
    errorMsg.textContent = "Please enter information first.";
    errorMsg.style.display = "block";
    return;
  }

  try {
    const { error } = await supabaseClient.from("knowledge").insert({
      agent_id: currentAgent.id,
      user_id: currentUser.id,
      type: "other",
      title: "Manual Training",
      content: text
    });
    if (error) throw error;

    textarea.value = "";
    successMsg.style.display = "block";
    await loadKnowledge();
  } catch (error) {
    console.error("Training error:", error);
    errorMsg.textContent = error.message || "Could not save training data.";
    errorMsg.style.display = "block";
  }
});

document.getElementById("websiteButton").addEventListener("click", async function () {
  const input = document.getElementById("websiteUrl");
  const message = document.getElementById("websiteInfo");
  const button = document.getElementById("websiteButton");

  let url = input.value.trim();
  if (!url) {
    message.className = "message error";
    message.textContent = "Please enter your website URL.";
    message.style.display = "block";
    return;
  }
  if (!url.startsWith("http://") && !url.startsWith("https://")) {
    url = "https://" + url;
  }
  try { new URL(url); } catch {
    message.className = "message error";
    message.textContent = "Please enter a valid website URL.";
    message.style.display = "block";
    return;
  }

  button.disabled = true;
  button.textContent = "⏳ Scanning Website...";
  message.className = "message info";
  message.textContent = "ShopBrain is reading your public website. Please wait...";
  message.style.display = "block";

  try {
    const response = await fetch("https://shopbrain-xdzo.onrender.com/crawl", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ url: url })
    });
    const data = await response.json();
    if (!response.ok) throw new Error(data.error || "The crawler could not access the website.");

    let websiteText = "";
    if (data.title) websiteText += "Website title: " + data.title + "\n\n";
    if (data.description) websiteText += "Website description: " + data.description + "\n\n";
    if (data.headings && data.headings.length) {
      websiteText += "Website sections:\n" + data.headings.join("\n") + "\n\n";
    }
    if (data.content) websiteText += "Website content:\n" + data.content;

    const { error: insertError } = await supabaseClient.from("knowledge").insert({
      agent_id: currentAgent.id,
      user_id: currentUser.id,
      type: "other",
      title: "Website Import (" + url + ")",
      content: websiteText
    });
    if (insertError) throw insertError;

    await loadKnowledge();
    message.className = "message success";
    message.textContent = "✅ Website imported successfully! Your AI has learned information from the website.";
    message.style.display = "block";
  } catch (error) {
    console.error(error);
    message.className = "message error";
    message.textContent = "❌ " + error.message;
    message.style.display = "block";
  } finally {
    button.disabled = false;
    button.textContent = "🔍 Import Website";
  }
});

init();
</script>
</body>
</html>