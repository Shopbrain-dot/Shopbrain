<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Create AI Agent - ShopBrain</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      background: #f5f7fb;
      color: #111827;
    }

    header {
      background: white;
      padding: 20px 7%;
      border-bottom: 1px solid #e5e7eb;
    }

    .logo {
      font-size: 24px;
      font-weight: bold;
    }

    .logo span {
      color: #2563eb;
    }

    .container {
      max-width: 850px;
      margin: 40px auto;
      padding: 0 20px;
    }

    .intro {
      margin-bottom: 25px;
    }

    .intro h1 {
      font-size: 32px;
      margin-bottom: 10px;
    }

    .intro p {
      color: #6b7280;
    }

    .form-card {
      background: white;
      padding: 30px;
      border-radius: 15px;
      box-shadow: 0 5px 20px rgba(0,0,0,0.05);
    }

    .section {
      margin-bottom: 30px;
    }

    .section h2 {
      font-size: 19px;
      margin-bottom: 15px;
    }

    label {
      display: block;
      font-weight: bold;
      margin-bottom: 7px;
    }

    input,
    textarea {
      width: 100%;
      padding: 13px;
      border: 1px solid #d1d5db;
      border-radius: 8px;
      margin-bottom: 18px;
      font-size: 15px;
      font-family: inherit;
    }

    textarea {
      min-height: 120px;
      resize: vertical;
    }

    input:focus,
    textarea:focus {
      outline: none;
      border-color: #2563eb;
    }

    .button {
      width: 100%;
      padding: 15px;
      background: #2563eb;
      color: white;
      border: none;
      border-radius: 9px;
      font-size: 16px;
      font-weight: bold;
      cursor: pointer;
    }

    .button:hover {
      background: #1d4ed8;
    }

    .success {
      display: none;
      margin-top: 20px;
      padding: 15px;
      background: #dcfce7;
      color: #166534;
      border-radius: 8px;
    }

    .continue {
      display: none;
      margin-top: 15px;
      width: 100%;
      padding: 15px;
      background: #111827;
      color: white;
      border-radius: 9px;
      text-decoration: none;
      text-align: center;
      font-weight: bold;
    }

    .continue:hover {
      background: #1f2937;
    }

    @media (max-width: 600px) {
      .container {
        margin: 25px auto;
      }

      .form-card {
        padding: 20px;
      }

      .intro h1 {
        font-size: 27px;
      }
    }
  </style>
</head>

<body>

<header>
  <div class="logo">
    Shop<span>Brain</span>
  </div>
</header>


<div class="container">

  <div class="intro">

    <h1>Create your AI Agent</h1>

    <p>
      Give ShopBrain the information it needs to provide
      accurate customer service.
    </p>

  </div>


  <div class="form-card">

    <form id="agentForm">


      <!-- AI AGENT -->

      <div class="section">

        <h2>🤖 AI Agent</h2>

        <label for="agentName">
          AI Agent Name
        </label>

        <input
          type="text"
          id="agentName"
          placeholder="Example: ShopBrain Assistant"
          required
        >

      </div>


      <!-- BUSINESS -->

      <div class="section">

        <h2>🏢 Business Information</h2>

        <label for="businessName">
          Business Name
        </label>

        <input
          type="text"
          id="businessName"
          placeholder="Example: Nestylo"
          required
        >


        <label for="businessDescription">
          What does your business do?
        </label>

        <textarea
          id="businessDescription"
          placeholder="Describe your business, products or services..."
          required
        ></textarea>

      </div>


      <!-- PRODUCTS -->

      <div class="section">

        <h2>📦 Products & Services</h2>

        <label for="products">
          Products / Services
        </label>

        <textarea
          id="products"
          placeholder="Example:

Wireless Earbuds - $19.99
Smart Watch - $29.99
Phone Case - $9.99"
        ></textarea>

      </div>


      <!-- FAQ -->

      <div class="section">

        <h2>❓ Frequently Asked Questions</h2>

        <label for="faqs">
          FAQs and Answers
        </label>

        <textarea
          id="faqs"
          placeholder="Example:

Q: How long does delivery take?
A: Delivery takes 3-5 business days.

Q: Do you accept returns?
A: Yes, within 14 days."
        ></textarea>

      </div>


      <!-- POLICIES -->

      <div class="section">

        <h2>🚚 Policies</h2>

        <label for="shipping">
          Shipping Information
        </label>

        <textarea
          id="shipping"
          placeholder="Enter your shipping information..."
        ></textarea>


        <label for="refund">
          Refund / Return Policy
        </label>

        <textarea
          id="refund"
          placeholder="Enter your refund and return policy..."
        ></textarea>

      </div>


      <!-- AI INSTRUCTIONS -->

      <div class="section">

        <h2>🧠 AI Instructions</h2>

        <label for="instructions">
          How should your AI behave?
        </label>

        <textarea
          id="instructions"
          placeholder="Example:

Be friendly and professional.
Keep answers short.
Never invent prices.
If you don't know something, tell the customer to contact support."
        ></textarea>

      </div>


      <!-- CREATE BUTTON -->

      <button
        class="button"
        type="submit"
      >
        Create AI Agent
      </button>


      <!-- SUCCESS -->

      <div
        class="success"
        id="success"
      >
        ✅ Your ShopBrain AI agent has been created!
      </div>


      <!-- TEST AI -->

      <a
        href="chat.html"
        class="continue"
        id="continueButton"
      >
        💬 Test Your AI →
      </a>


    </form>

  </div>

</div>


<script>

  const form =
    document.getElementById("agentForm");

  form.addEventListener(
    "submit",
    function(event) {

      event.preventDefault();


      const agent = {

        agentName:
          document.getElementById("agentName").value,

        businessName:
          document.getElementById("businessName").value,

        businessDescription:
          document.getElementById("businessDescription").value,

        products:
          document.getElementById("products").value,

        faqs:
          document.getElementById("faqs").value,

        shipping:
          document.getElementById("shipping").value,

        refund:
          document.getElementById("refund").value,

        instructions:
          document.getElementById("instructions").value

      };


      localStorage.setItem(
        "shopbrainAgent",
        JSON.stringify(agent)
      );


      document.getElementById(
        "success"
      ).style.display = "block";


      document.getElementById(
        "continueButton"
      ).style.display = "block";

    }

  );

</script>

</body>
</html>